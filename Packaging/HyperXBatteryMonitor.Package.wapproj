<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props" />

  <PropertyGroup>
    <ProjectGuid>{B8C6E9D4-4F76-4B16-9F0C-2A0A7D6E8A21}</ProjectGuid>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Always</AppxBundle>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <UapAppxPackageBuildMode>StoreUpload</UapAppxPackageBuildMode>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageDir>$(MSBuildProjectDirectory)\..\Releases\MSIX\</AppxPackageDir>
    <EntryPointProjectUniqueName>..\HyperXBatteryMonitor.csproj</EntryPointProjectUniqueName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HyperXBatteryMonitor.csproj">
      <SkipGetTargetFrameworkProperties>True</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest" />
    <Content Include="..\Assets\Packaging\Square44x44Logo.png">
      <Link>Assets\Square44x44Logo.png</Link>
    </Content>
    <Content Include="..\Assets\Packaging\Square150x150Logo.png">
      <Link>Assets\Square150x150Logo.png</Link>
    </Content>
    <Content Include="..\Assets\Packaging\StoreLogo.png">
      <Link>Assets\StoreLogo.png</Link>
    </Content>
  </ItemGroup>

  <Import Project="$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.targets" />
</Project>
